{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": ["**/*.md", "**/*.yml"],
        "exclude": [
          "book/**",
          "mdbook/**",
          "_site/**",
          ".attachments/**",
          ".obsidian/**",
          "SUMMARY.md",
          "README.md",
          "Integrations/Autodesk/BIM-360.md",
          "Online-Services/Alliance-Business-Cloud.md",
          "Online-Services/Alliance-Business-Cloud/About.md",
          "Integrations/PayU.md",
          "Integrations/ePayco.md",
          "Integrations/Mercado-Pago.md",
          "Online-Services/Alliance-Pay-Platform.md",
          "Online-Services/Infinity-Comex-Marketplace/Policies/**",
          "Online-Services/Infinity-Comex-Marketplace/Pricing-&-Promos.md",
          "Online-Services/Terms-and-Conditions.md",
          "Capabilities/Alliance-Business-Studio/License.md",
          "Capabilities/Alliance-Business-Platform/Services/SMTP-Service.md",
          "Capabilities/Alliance-Passport-Service/Security-Groups.md",
          "Modules/BOTS.md",
          "Fundamentals/Shortcuts.md",
          "reference/Security.md",
          "reference/License.md",
          "Modules/SECURITY.md",
          "Modules/Signator/DIAN-Invoicing.md",
          "Services/Reference/Wallets.md",
          "Services/Reference/Inventory.md",
          "tools/**",
          "**/node_modules/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          ".attachments/**",
          "**/*.png",
          "**/*.jpg",
          "**/*.jpeg",
          "**/*.gif",
          "**/*.svg"
        ],
        "exclude": ["book/**", "mdbook/**", "_site/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "templates/singulinkfx", "templates/abs"],
    "globalMetadata": {
      "_appName": "Alliance Business Suite",
      "_appTitle": "Alliance Business Suite Documentation",
      "_appLogoPath": "Icon.png",
      "_appFaviconPath": "Icon.png",
      "_appFooter": "Alliance Business Suite · Documentation",
      "_enableSearch": true,
      "_disableContribution": true,
      "_disableAffix": false
    }
  }
}
